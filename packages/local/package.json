{
  "name": "@open-tuya/local",
  "version": "0.0.1",
  "description": "Unofficial client for the Tuya local protocol: discover Tuya devices on the LAN, and read and write their data points with no cloud.",
  "keywords": [
    "tuya",
    "tuya-local",
    "localtuya",
    "local-control",
    "local-api",
    "lan",
    "smart-life",
    "home-automation",
    "smart-home"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cheziyi/open-tuya#readme",
  "bugs": "https://github.com/cheziyi/open-tuya/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheziyi/open-tuya.git",
    "directory": "packages/local"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "tsc && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@open-tuya/core": "workspace:^"
  },
  "devDependencies": {
    "@open-tuya/simulators": "workspace:^"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

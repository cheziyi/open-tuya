{
  "name": "@open-tuya/mqtt",
  "version": "0.0.0",
  "description": "The MQTT 3.1.1 client the open-tuya cloud packages receive Tuya's pushed device updates through, renewing its credentials as they expire.",
  "keywords": [
    "tuya",
    "mqtt",
    "tuya-cloud"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cheziyi/open-tuya#readme",
  "bugs": "https://github.com/cheziyi/open-tuya/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheziyi/open-tuya.git",
    "directory": "packages/mqtt"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "tsc && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@open-tuya/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "aedes": "^1.2.0"
  }
}

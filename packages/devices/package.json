{
  "name": "@open-tuya/devices",
  "version": "0.0.2",
  "description": "Catalog of Tuya devices and what each of their data points controls.",
  "keywords": [
    "tuya",
    "tuya-devices",
    "data-points",
    "device-catalog",
    "home-automation",
    "smart-home"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cheziyi/open-tuya#readme",
  "bugs": "https://github.com/cheziyi/open-tuya/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheziyi/open-tuya.git",
    "directory": "packages/devices"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "tsc && vitest run --passWithNoTests",
    "import-catalog": "node scripts/importTuyaLocal.ts"
  },
  "dependencies": {
    "@open-tuya/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }

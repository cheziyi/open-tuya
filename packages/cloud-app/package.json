{
  "name": "@open-tuya/cloud-app",
  "version": "0.0.6",
  "description": "Unofficial client for the Tuya cloud as the Smart Life app reaches it, signed in by scanning a QR code: list devices with their local keys, and read and write their data points.",
  "keywords": [
    "tuya",
    "tuya-cloud",
    "smart-life",
    "tuya-smart",
    "qr-code-login",
    "home-automation",
    "smart-home",
    "tuya-api",
    "smart-life-api",
    "iot",
    "nodejs",
    "typescript",
    "open-tuya"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cheziyi/open-tuya/tree/main/packages/cloud-app#readme",
  "bugs": "https://github.com/cheziyi/open-tuya/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheziyi/open-tuya.git",
    "directory": "packages/cloud-app"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "tsc && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@open-tuya/core": "workspace:^",
    "mqtt": "^5.16.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "aedes": "^1.2.0"
  }
}
